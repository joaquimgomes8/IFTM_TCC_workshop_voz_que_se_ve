/* ─── Reset & Base ──────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #f4f6fb;
  --surface:   #ffffff;
  --primary:   #1565c0;
  --primary-dark: #0d47a1;
  --accent:    #00897b;
  --accent-dark: #00695c;
  --libras:    #6a1b9a;
  --libras-dark: #4a148c;
  --danger:    #c62828;
  --text:      #1a1a2e;
  --text-muted:#607d8b;
  --border:    #cfd8dc;
  --yellow-bg: #fffde7;
  --yellow-bd: #f9a825;
  --blue-bg:   #e3f2fd;
  --radius:    12px;
  --shadow:    0 4px 20px rgba(0,0,0,0.08);
}

body {
  font-family: 'Nunito', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24px 16px 80px;
}

/* ─── Header ────────────────────────────────────────────────────────────── */
header {
  text-align: center;
  margin-bottom: 28px;
}

h1 {
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--primary-dark);
  letter-spacing: -0.5px;
}

.subtitle {
  color: var(--text-muted);
  font-size: 1rem;
  margin-top: 4px;
}

/* ─── Main layout ───────────────────────────────────────────────────────── */
main {
  width: 100%;
  max-width: 680px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ─── Cards ─────────────────────────────────────────────────────────────── */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
  border: 1.5px solid var(--border);
}

.highlight-card {
  border-color: var(--yellow-bd);
  background: var(--yellow-bg);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 8px;
}

.card-header strong {
  font-size: 1rem;
  color: var(--text);
}

/* ─── Botões principais ──────────────────────────────────────────────────── */
.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 14px;
}

button {
  font-family: 'Nunito', sans-serif;
  font-size: 1rem;
  font-weight: 700;
  padding: 10px 22px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: background 0.18s, transform 0.15s, box-shadow 0.15s;
  outline: none;
}

button:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}

#start {
  background: var(--accent);
  color: #fff;
}
#start:hover:not([disabled]) { background: var(--accent-dark); transform: scale(1.04); }

#stop {
  background: var(--danger);
  color: #fff;
}
#stop:hover:not([disabled]) { filter: brightness(1.1); transform: scale(1.04); }

.btn-secondary {
  background: #eceff1;
  color: var(--text);
  border: 1.5px solid var(--border);
}
.btn-secondary:hover:not([disabled]) { background: #cfd8dc; transform: scale(1.04); }

button[disabled] {
  background: #b0bec5;
  color: #fff;
  cursor: not-allowed;
  transform: none !important;
}

/* ─── Botão VLibras ──────────────────────────────────────────────────────── */
.btn-libras {
  background: var(--libras);
  color: #fff;
  font-size: 0.95rem;
  padding: 8px 16px;
  border-radius: 8px;
  font-weight: 700;
  letter-spacing: 0.3px;
  box-shadow: 0 2px 8px rgba(106,27,154,0.25);
}
.btn-libras:hover:not([disabled]) {
  background: var(--libras-dark);
  transform: scale(1.05);
  box-shadow: 0 4px 14px rgba(106,27,154,0.35);
}

.btn-mini {
  font-size: 0.82rem;
  padding: 5px 10px;
  background: #eceff1;
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 6px;
}
.btn-mini:hover { background: #cfd8dc; }

.btn-libras-mini {
  background: #ede7f6;
  color: var(--libras);
  border-color: #ce93d8;
}
.btn-libras-mini:hover { background: #d1c4e9; }

.btn-danger {
  background: #ffebee;
  color: var(--danger);
  border-color: #ef9a9a;
}
.btn-danger:hover { background: #ffcdd2; }

/* ─── Status ─────────────────────────────────────────────────────────────── */
#status {
  font-weight: 700;
  font-size: 1rem;
  min-height: 22px;
  color: var(--text-muted);
}

#status[data-active="true"] {
  color: var(--danger);
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.5; }
}

/* ─── Sessão atual ───────────────────────────────────────────────────────── */
#sessaoAtual {
  min-height: 60px;
  font-size: 1.25rem;
  line-height: 1.6;
  color: #333;
  padding: 4px 0;
}

/* ─── Painel VLibras ─────────────────────────────────────────────────────── */
.vlibras-panel {
  display: none;
  margin-top: 14px;
  background: #ede7f6;
  border: 2px solid var(--libras);
  border-radius: 10px;
  padding: 14px 16px;
}

.vlibras-panel p {
  font-size: 1.1rem;
  color: var(--libras-dark);
  font-weight: 600;
  line-height: 1.6;
}

.libras-instrucao {
  margin-top: 10px;
  background: #e8f5e9;
  border: 1.5px solid #81c784;
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 0.92rem;
  color: #2e7d32;
  line-height: 1.5;
}

/* ─── Histórico ──────────────────────────────────────────────────────────── */
#historico {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-height: 360px;
  overflow-y: auto;
  padding-right: 4px;
}

.bloco-sessao {
  background: var(--blue-bg);
  border: 1.5px solid #90caf9;
  border-radius: 10px;
  padding: 12px 14px;
}

.sessao-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.sessao-num {
  font-weight: 800;
  font-size: 0.85rem;
  color: var(--primary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.sessao-data {
  font-size: 0.78rem;
  color: var(--text-muted);
}

.sessao-texto {
  font-size: 1.05rem;
  color: var(--text);
  line-height: 1.55;
  margin-bottom: 10px;
}

.sessao-acoes {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.empty-msg {
  color: var(--text-muted);
  font-size: 0.95rem;
  text-align: center;
  padding: 20px 0;
}

/* ─── Responsivo ─────────────────────────────────────────────────────────── */
@media (max-width: 500px) {
  h1 { font-size: 1.8rem; }

  .controls { gap: 8px; }

  button { font-size: 0.92rem; padding: 9px 14px; }

  #sessaoAtual { font-size: 1.1rem; }

  .card-header { flex-direction: column; align-items: flex-start; }
}